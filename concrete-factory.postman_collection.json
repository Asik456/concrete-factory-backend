{
  "info": {
    "name": "Concrete Factory API",
    "_postman_id": "cf-backend-v1",
    "description": "REST API for Concrete Factory Backend — Gin + GORM + JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "token",    "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/health" }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/register" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aibek Seitkali\",\n  \"phone\": \"+77001234567\",\n  \"email\": \"aibek@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/login" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aibek@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          }
        },
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/login" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@jbibeton.kz\",\n  \"password\": \"Admin123456\"\n}"
            }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/me" },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/categories" }
          }
        },
        {
          "name": "Create Category (Admin)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/categories" },
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name_ru\": \"Железобетон\",\n  \"name_kz\": \"Темірбетон\",\n  \"name_en\": \"Reinforced Concrete\",\n  \"slug\": \"reinforced-concrete\"\n}"
            }
          }
        },
        {
          "name": "Update Category (Admin)",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{base_url}}/categories/1" },
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name_ru\": \"Товарный бетон (обновлено)\",\n  \"name_kz\": \"Тауарлы бетон\",\n  \"name_en\": \"Ready-Mix Concrete\",\n  \"slug\": \"ready-mix-concrete\"\n}"
            }
          }
        },
        {
          "name": "Delete Category (Admin)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/categories/4" },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/products" }
          }
        },
        {
          "name": "Get Products by Category",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/products?category_id=1" }
          }
        },
        {
          "name": "Get Products — Search",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/products?search=М200" }
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/products/1" }
          }
        },
        {
          "name": "Create Product (Admin)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/products" },
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": 1,\n  \"name_ru\": \"Бетон М500 (B40)\",\n  \"name_kz\": \"Бетон М500 (B40)\",\n  \"name_en\": \"Concrete M500 (B40)\",\n  \"description_ru\": \"Специальный высокопрочный бетон.\",\n  \"description_kz\": \"Арнайы жоғары беріктікті бетон.\",\n  \"description_en\": \"Special high-strength concrete.\",\n  \"price\": 65000,\n  \"is_active\": true,\n  \"specs\": [\n    { \"key\": \"Класс прочности\", \"value\": \"B40\" },\n    { \"key\": \"Морозостойкость\", \"value\": \"F300\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "Update Product (Admin)",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{base_url}}/products/1" },
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": 1,\n  \"name_ru\": \"Бетон М100 (B7.5) — акция\",\n  \"name_kz\": \"Бетон М100 (B7.5)\",\n  \"name_en\": \"Concrete M100 (B7.5) — sale\",\n  \"description_ru\": \"Акционная цена на М100.\",\n  \"description_kz\": \"М100 арнайы бағасы.\",\n  \"description_en\": \"Sale price on M100.\",\n  \"price\": 25000,\n  \"discount_price\": 22000,\n  \"is_active\": true,\n  \"specs\": [\n    { \"key\": \"Класс прочности\", \"value\": \"B7.5\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "Delete Product (Admin)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/products/10" },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/orders" },
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"delivery_type\": \"delivery\",\n  \"delivery_address\": \"г. Алматы, ул. Абая 1\",\n  \"delivery_cost\": 3000,\n  \"items\": [\n    { \"product_id\": 2, \"quantity\": 3 },\n    { \"product_id\": 5, \"quantity\": 1 }\n  ]\n}"
            }
          }
        },
        {
          "name": "My Orders",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/my-orders" },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get All Orders (Admin)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/orders" },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Update Order Status (Admin)",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{base_url}}/orders/1/status" },
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"confirmed\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Payment",
      "item": [
        {
          "name": "Checkout (Card)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/payment/checkout" },
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_id\": 1,\n  \"method\": \"card\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Inquiries",
      "item": [
        {
          "name": "Create Inquiry (Public)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/inquiries" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Нурлан Асанов\",\n  \"phone\": \"+77779001122\",\n  \"message\": \"Нужен бетон М300, 20 кубов, доставка в Алматы.\"\n}"
            }
          }
        },
        {
          "name": "Get All Inquiries (Admin)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/inquiries" },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Mark Inquiry as Read (Admin)",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{base_url}}/inquiries/1/read" },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get All Users (Admin)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/users" },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Send Notification (Resty v2 to microservice)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/notify" },
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 1,\n  \"message\": \"Ваш заказ подтверждён!\"\n}"
            }
          }
        }
      ]
    }
  ]
}
