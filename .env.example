# Скопируйте этот файл в .env и заполните реальными значениями.
# .env никогда не коммитится (см. .gitignore).

# PostgreSQL
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=
DB_NAME=concrete_factory
DB_PORT=5432

# JWT
JWT_SECRET=

# Микросервис уведомлений
NOTIFICATION_URL=http://localhost:8081

# Миграции
MIGRATIONS_PATH=file://db/migrations

# Первичный админ-аккаунт (создаётся один раз при пустой таблице users)
ADMIN_EMAIL_DEFAULT=
ADMIN_PASSWORD_DEFAULT=

# Gmail SMTP для писем (код подтверждения, уведомления о заявках)
# SMTP_PASSWORD — это Gmail App Password (myaccount.google.com -> Security -> App Passwords),
# НЕ обычный пароль от почты. Никогда не коммитьте реальное значение.
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=

# Frontend
VITE_API_URL=http://localhost:8080
